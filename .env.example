# Secret untuk mengakses endpoint admin (/admin/keys/*). Wajib diganti sebelum deploy!
ADMIN_SECRET=change-me-admin-secret

# Secret untuk menandatangani JWT access token. Wajib diganti sebelum deploy!
JWT_SECRET=change-me-jwt-secret

# Algoritma JWT (default HS256)
JWT_ALGORITHM=HS256

# Umur access token dalam detik (default 3600 = 1 jam)
JWT_EXPIRY_SECONDS=3600

# Kuota request harian default untuk API key baru (bisa dioverride per-key saat create)
DEFAULT_DAILY_QUOTA=1000

# Koneksi database (SQLite lokal secara default)
DATABASE_URL=sqlite:///./data.db
